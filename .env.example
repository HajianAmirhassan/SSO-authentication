# این فایل را به .env کپی کنید و مقادیر را پر کنید. فایل .env نباید commit شود.
# نکته: اگر رمزی شامل $ است، آن را $$ بنویسید (docker compose آن را متغیر تفسیر می‌کند).

# باید با keycloak.version در pom.xml یکی باشد
KC_VERSION=26.8.0

POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me

# آدرس عمومی SSO. برای تست محلی: http://localhost:8080
# در Production پشت reverse proxy با HTTPS: https://sso.palaz.local
KC_HOSTNAME=http://localhost:8080

KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Active Directory ---
SSO_LDAP_URL=ldaps://headdcsrv1.palaz.local:636
SSO_LDAP_BIND_DN=CN=svc-keycloak,OU=Service Accounts,DC=palaz,DC=local
# اختیاری؛ فقط در اولین import خوانده می‌شود. خالی بماند ← بعداً از پنل وارد شود
SSO_LDAP_BIND_PASSWORD=
# محدوده جستجوی کاربران؛ بهتر است به OU کاربران واقعی محدود شود
SSO_LDAP_USERS_DN=DC=palaz,DC=local
# محل گروه‌های SSO-* در AD
SSO_LDAP_GROUPS_DN=DC=palaz,DC=local
